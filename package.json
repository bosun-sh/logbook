{
  "name": "@bosun-sh/logbook",
  "version": "2.0.3",
  "description": "File-system kanban board CLI and MCP server for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "author": "bosun.sh",
  "keywords": [
    "kanban",
    "tasks",
    "mcp",
    "ai",
    "agents",
    "cli",
    "logbook"
  ],
  "bugs": {
    "url": "https://github.com/bosun-sh/logbook/issues"
  },
  "homepage": "https://github.com/bosun-sh/logbook#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bosun-sh/logbook.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "logbook": "bin/logbook.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-hook-templates.mjs",
    "prepack": "bun run build",
    "start": "bun src/workspace/bin-cli.ts mcp",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "bun test tests/e2e/",
    "test:smoke": "bun test tests/smoke/",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "ci:lint": "bun run check && bun run typecheck",
    "ci:build": "bun run build && node scripts/npm-pack-dry-run.mjs",
    "ci:test": "bun test",
    "ci:precommit": "bun run ci:lint && bun run test:unit",
    "ci:premerge": "bun run ci:lint && bun run ci:test && bun run ci:build",
    "ci:prepush": "bun run ci:premerge",
    "prepare": "husky",
    "prepublishOnly": "bun run ci:premerge",
    "release:dry-run": "bun run ci:premerge",
    "release": "bun run release:dry-run && node scripts/npm-publish.mjs",
    "publish:dev": "bun link .",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "@bosun-sh/ohtools": "^0.1.0",
    "@duckdb/node-api": "1.5.2-r.1",
    "effect": "3.21.2",
    "smol-toml": "^1.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "husky": "^9.0.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.7.3"
  }
}
